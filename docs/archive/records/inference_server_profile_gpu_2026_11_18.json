  "thread_tree.py": "\"\"\"Summarize one thread of a macOS `sample` call graph.\n\nUsage: thread_tree.py SAMPLE.txt THREAD_ID [MARKER ...]\nPrints the thread's samples, its self samples by function (top 40), and for each\nmarker substring the samples of the outermost frames whose names contain it.\n\"\"\"\nimport re\nimport sys\nfrom collections import Counter\n\npath, thread = sys.argv[1], sys.argv[2]\nmarkers = sys.argv[3:]\nlines = open(path, errors=\"replace\").read().splitlines()\nstart = next(i for i, line in enumerate(lines) if f\"Thread_{thread}\" in line and re.match(r\"\\s+\\d+ Thread_\", line))\nindent = len(lines[start]) - len(lines[start].lstrip())\nend = next((i for i in range(start + 1, len(lines))\n            if re.match(r\"\\s{%d}\\d+ Thread_\" % indent, lines[i]) or not lines[i].strip()), len(lines))\nentry = re.compile(r\"^([\\s+!:|]*)(\\d+) (.*)$\")\nnodes = []  # (depth, count, name)\nfor line in lines[start + 1:end]:\n    matched = entry.match(line)\n    if matched:\n        nodes.append((len(matched.group(1)), int(matched.group(2)), matched.group(3)))\ntotal = int(entry.match(lines[start]).group(2))\nprint(f\"thread {thread}: {total} samples\")\n\n\ndef short(name: str) -> str:\n    name = re.sub(r\"\\s+\\[0x[0-9a-f,]+\\]$\", \"\", name)\n    name = re.sub(r\"\\s+\\+ \\d+(,\\d+)*$\", \"\", name)\n    return name[:150]\n\n\nself_counts = Counter()\nfor index, (depth, count, name) in enumerate(nodes):\n    children = 0\n    for later in nodes[index + 1:]:\n        if later[0] <= depth:\n            break\n        if later[0] == min(n[0] for n in nodes[index + 1:index + 2]) and later[0] > depth:\n            pass\n    # Children are the following nodes at the next deeper depth before returning to this depth.\n    child_depth = None\n    for later in nodes[index + 1:]:\n        if later[0] <= depth:\n            break\n        if child_depth is None:\n            child_depth = later[0]\n        if later[0] == child_depth:\n            children += later[1]\n    self_counts[short(name)] += count - children\nprint(\"self samples by function:\")\nfor name, count in self_counts.most_common(40):\n    print(f\"  {count:6d} {count / total:6.1%}  {name}\")\nfor marker in markers:\n    outermost, inside_depth = 0, None\n    for depth, count, name in nodes:\n        if inside_depth is not None and depth <= inside_depth:\n            inside_depth = None\n        if inside_depth is None and marker in name:\n            outermost += count\n            inside_depth = depth\n    print(f\"marker {marker!r}: {outermost} samples, {outermost / total:.1%}\")\n",
  "compile_ops.py": "\"\"\"Which PyTorch operations lead to MPSGraph compiling, in one thread of a `sample` call graph.\n\nUsage: compile_ops.py SAMPLE.txt THREAD_ID\nFor every outermost frame containing 'mlir::' or 'commonPreInitWithDescriptor', it\ncounts the samples under the nearest enclosing frame naming an at::native or\nat::_ops operation, and the nearest enclosing Python-level PyTorch binding.\n\"\"\"\nimport re\nimport sys\nfrom collections import Counter\n\npath, thread = sys.argv[1], sys.argv[2]\nlines = open(path, errors=\"replace\").read().splitlines()\nstart = next(i for i, line in enumerate(lines) if f\"Thread_{thread}\" in line and re.match(r\"\\s+\\d+ Thread_\", line))\nindent = len(lines[start]) - len(lines[start].lstrip())\nend = next((i for i in range(start + 1, len(lines))\n            if re.match(r\"\\s{%d}\\d+ Thread_\" % indent, lines[i]) or not lines[i].strip()), len(lines))\nentry = re.compile(r\"^([\\s+!:|]*)(\\d+) (.*)$\")\nstack: list[tuple[int, str]] = []\nby_op, by_binding = Counter(), Counter()\ninside = None\nfor line in lines[start + 1:end]:\n    matched = entry.match(line)\n    if not matched:\n        continue\n    depth, count, name = len(matched.group(1)), int(matched.group(2)), matched.group(3)\n    while stack and stack[-1][0] >= depth:\n        stack.pop()\n    if inside is not None and depth <= inside:\n        inside = None\n    if inside is None and (\"mlir::\" in name or \"commonPreInitWithDescriptor\" in name):\n        inside = depth\n        op = next((frame for _, frame in reversed(stack) if \"at::native::\" in frame or \"at::_ops::\" in frame), \"?\")\n        binding = next((frame for _, frame in reversed(stack) if \"THPVariable_\" in frame or \"torch::autograd::\" in frame\n                        or \"THPModule\" in frame), \"?\")\n        by_op[re.sub(r\"\\(.*\", \"\", op.split(\"  (in\")[0])[:110]] += count\n        by_binding[re.sub(r\"\\(.*\", \"\", binding.split(\"  (in\")[0])[:110]] += count\n    stack.append((depth, name))\ntotal = sum(by_op.values())\nprint(f\"compile samples: {total}\")\nfor name, count in by_op.most_common(25):\n    print(f\"  {count:6d} {count / total:6.1%}  {name}\")\nprint(\"by Python binding:\")\nfor name, count in by_binding.most_common(15):\n    print(f\"  {count:6d} {count / total:6.1%}  {name}\")\n"
 }
}
