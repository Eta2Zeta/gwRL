  "source_findings": [
    {
      "id": "evacuation_roles",
      "authority": "RCL-014 provisionally adopted by the user, pending developer clarification",
      "source": "RB11.5 p78 requires combat; the adopted campaign interpretation assigns the evacuating fleet as attacker.",
      "verified": "Selection of up to three ships precedes resulting battles. Enemy participants are the actual fleet at sea; the calendar slot does not choose roles. Multiple destination battles finish before suspended bombing resumes. No adjacent retreat sea is invented for departure directly from a port."
    },
    {
      "id": "screening_continuation",
      "authority": "RB9.4.2 p58 and naval sequence p69",
      "verified": "Victorious continuing ships may stop, continue their original route, pick up unmoved land units, and declare the subsequent assault in Combat. Unrelated ships do not receive another movement phase. Blockaded-port waiting ships stay in berth until the screening succeeds."
    },
    {
      "id": "naval_retreat_origins",
      "authority": "RB10.3 p62",
      "verified": "Retreat uses an actual adjacent sea entry. The printed naval rule supplies no Friendly-possession or enemy-free filter; the contested-retreat trace includes an enemy ship in the actual origin and retains both that ship and linked cargo."
    },
    {
      "id": "combined_land_amphibious_order",
      "authority": "RB10.8 pp70-71",
      "verified": "Same-attacker, same-target land combat waits for amphibious preparation. Shore and Coastal Artillery first strikes precede the merged land battle. Both origins survive registration; overland units may retreat while assaulting units remain. Other targets and other attackers are not blocked by the guard."
    },
    {
      "id": "launching_sea_clearance",
      "authority": "RB10.8.1 p70 with the continuing-force exception in RB9.4.2 p58",
      "verified": "An assault declaration is offered after its launching sea is clear. This prevents an impossible declaration with no screening battle from trapping Combat. The contested-success trace still declares and lands via the printed continuing-force exception."
    },
    {
      "id": "actual_naval_air_declarations",
      "authority": "RB9.1 p54, RB10.6.4 p68 and RB10.7 pp68-69",
      "verified": "The public naval_air_attack and naval_port_attack actions preserve a string context, commit the aircraft to air_combat, advance from Combat Movement into Combat, and do not permit an extra flight or early landing. Ships cannot scramble out into a port attack; the port attack is aircraft versus defending Fighters and ships in port. MAP attacks use their explicit Combat-phase declaration."
    },
    {
      "id": "end_of_movement_berthing",
      "authority": "RB11.5 pp77-78 and shared mandatory landing/withdrawal rules",
      "verified": "Berthing cannot strand mandatory aircraft landing or Chinese-gift withdrawal, including a restored berthing marker. Ordinary movement remains closed after end-of-movement berthing."
    },
    {
      "id": "destroyer_transport_source_correction",
      "authority": "Japan reference sheet PDF p4",
      "verified": "The transport permission is one Marine per Japanese Destroyer, -1 movement while loaded, and no further movement after unloading. The former profile citation to rulebook p105 was replaced by Japan NRS p4; no new gameplay ruling was introduced."
    },
    {
      "id": "geographic_and_campaign_exclusions",
      "authority": "RB13.2.7 p98 and frozen campaign contract",
      "verified": "Neither retained narrow crossing requires a naval passage. Ordinary sea entry gets no invented passage fire. Convoy raiding, interdiction, Kido Butai and off-map states remain inactive."
    }
  ],
